# RK3588 USB gateway kernel config fragment
#
# Required for:
# - C0: HID keyboard + HID mouse + USB printer gadget
# - C1: USB mass-storage gadget
# - Local read of MSC backing image through loop-mounted VFAT

CONFIG_CONFIGFS_FS=y

CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
# Keep Rockchip/Android USB_STATE uevent setup path disabled. On RK3588
# 5.10.160 it can crash in android_setup() during multi-function EP0 setup.
# CONFIG_USB_CONFIGFS_UEVENT is not set

CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y

CONFIG_USB_F_HID=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_PRINTER=y
CONFIG_USB_CONFIGFS_F_PRINTER=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

CONFIG_BLK_DEV_LOOP=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_PRINTER=y

CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_SYSFS=y
